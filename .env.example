# STATUS: Implemented (this file). Copy to .env.local and fill in real
# values — nothing here is a real credential.

# --- Database (required) ---
DATABASE_URL="postgresql://user:password@localhost:5432/resumeforge?schema=public"

# --- Auth (required) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- AI provider (required for all /api/ai/* routes) ---
AI_API_KEY="sk-ant-...."
AI_MODEL="claude-sonnet-4-6"

# --- Rate limiting (optional — falls back to in-memory single-instance limiter if unset) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Email (optional — logs to console instead of sending if unset) ---
RESEND_API_KEY=""
EMAIL_FROM="ResumeForge AI <no-reply@yourdomain.com>"

# --- Payments (required for Stage 2 Section 10 — not yet wired in this pass, see STATUS.md) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_PREMIUM=""

# --- File storage (optional — only needed if/when profile image upload ships) ---
STORAGE_PROVIDER="s3"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION=""
